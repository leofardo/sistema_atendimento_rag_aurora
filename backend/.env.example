OPENAI_API_KEY=coloque_sua_chave_aqui

# Modelos (preços em app/nucleo/precos.py)
OPENAI_MODELO_RESPOSTA=gpt-4.1-mini
OPENAI_MODELO_ROTEADOR=gpt-4.1-nano
# Depois do fine-tuning: OPENAI_MODELO_ROTEADOR=ft:gpt-4.1-nano-2025-04-14:sua-org:roteador-aurora:xxxx
OPENAI_MODELO_EMBEDDING=text-embedding-3-small
OPENAI_DIMENSOES_EMBEDDING=1536
OPENAI_MAX_TOKENS_RESPOSTA=450
OPENAI_TIMEOUT_SECONDS=60

# RAG
RAG_TOP_K=4
RAG_SIMILARIDADE_MINIMA=0.40
RAG_PESO_BM25=0.2
CACHE_SIMILARIDADE=0.95
CACHE_VALIDADE_HORAS=168

# Conversa
HISTORICO_MENSAGENS=6
HISTORICO_LIMITE_CARACTERES=500
# Deixe vazio para usar SQLite. Com Redis: redis://localhost:6379/0
REDIS_URL=
CONVERSA_TTL_SEGUNDOS=86400

FRONTEND_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
# Reserva se AwesomeAPI e Banco Central falharem
COTACAO_DOLAR=5.40
